        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:orientation="vertical" android:paddingTop="5dp">
            <TextView android:id="@+id/widget_rl_8" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:fontFamily="sans-serif" android:textColor="@color/widget_text_primary" android:textSize="9sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_rlt_8" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:includeFontPadding="false" android:lineSpacingExtra="-2dp" android:textColor="@color/widget_text_secondary" android:textSize="7sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:orientation="vertical" android:paddingTop="5dp">
            <TextView android:id="@+id/widget_rl_9" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:fontFamily="sans-serif" android:textColor="@color/widget_text_primary" android:textSize="9sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_rlt_9" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:includeFontPadding="false" android:lineSpacingExtra="-2dp" android:textColor="@color/widget_text_secondary" android:textSize="7sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout android:id="@+id/widget_cell_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginLeft="1.5dp" android:layout_marginRight="1.5dp">
        <ImageView android:id="@+id/widget_cell_border_1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
        <ImageView android:id="@+id/widget_cell_bg_1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
        <TextView android:id="@+id/widget_cell_tx_1" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:fontFamily="sans-serif" android:maxLines="20" android:lineSpacingExtra="-2dp" android:paddingLeft="3dp" android:paddingRight="3dp" android:textColor="@color/widget_text_primary" android:textSize="9sp" android:textStyle="bold" />
    </FrameLayout>
    <FrameLayout android:id="@+id/widget_cell_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginLeft="1.5dp" android:layout_marginRight="1.5dp">
        <ImageView android:id="@+id/widget_cell_border_2" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
        <ImageView android:id="@+id/widget_cell_bg_2" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
        <TextView android:id="@+id/widget_cell_tx_2" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:fontFamily="sans-serif" android:maxLines="20" android:lineSpacingExtra="-2dp" android:paddingLeft="3dp" android:paddingRight="3dp" android:textColor="@color/widget_text_primary" android:textSize="9sp" android:textStyle="bold" />
    </FrameLayout>
    <FrameLayout android:id="@+id/widget_cell_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginLeft="1.5dp" android:layout_marginRight="1.5dp">
        <ImageView android:id="@+id/widget_cell_border_3" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
        <ImageView android:id="@+id/widget_cell_bg_3" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
        <TextView android:id="@+id/widget_cell_tx_3" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:fontFamily="sans-serif" android:maxLines="20" android:lineSpacingExtra="-2dp" android:paddingLeft="3dp" android:paddingRight="3dp" android:textColor="@color/widget_text_primary" android:textSize="9sp" android:textStyle="bold" />
    </FrameLayout>
    <FrameLayout android:id="@+id/widget_cell_4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginLeft="1.5dp" android:layout_marginRight="1.5dp">
