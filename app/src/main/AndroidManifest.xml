<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 更新功能：交由系统安装器安装下载的 APK（仍需用户在系统弹窗确认）。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 课前提醒：精确闹钟（Android 12+ 声明；未授权时自动降级为宽松窗口闹钟）。 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <queries>
        <!-- Android 11+ 包可见性：允许找到系统包安装器。 -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="content" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
    </queries>

    <application
        android:name=".AwakeApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:icon="@drawable/awake_app_icon"
        android:roundIcon="@drawable/awake_app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.Awake"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">
        <receiver
            android:name=".data.notification.CourseReminderReceiver"
            android:exported="false" />
        <receiver
            android:name=".data.notification.ReminderBootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".data.widget.AwakeWidgetProvider"
            android:label="@string/widget_name"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/awake_widget_info" />
        </receiver>

        <!-- 周课表集合组件的数据源（RemoteViewsService）。 -->
        <service
            android:name=".data.widget.AwakeWidgetListService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Awake">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 更新功能：向系统安装器暴露已下载的 APK。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 小组件配置页：添加组件时选择课表；组件上「课表」按钮可再次选择。 -->
        <activity
            android:name=".ui.widget.AwakeWidgetConfigActivity"
            android:exported="true"
            android:label="@string/widget_config_title"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Awake">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>
</manifest>
