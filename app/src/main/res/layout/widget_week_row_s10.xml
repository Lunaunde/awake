        <TextView android:id="@+id/widget_cell_tx_5" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:fontFamily="sans-serif" android:maxLines="20" android:lineSpacingExtra="-2dp" android:paddingLeft="3dp" android:paddingRight="3dp" android:textColor="@color/widget_text_primary" android:textSize="9sp" android:textStyle="bold" />
    </FrameLayout>
    <FrameLayout android:id="@+id/widget_cell_6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginLeft="1.5dp" android:layout_marginRight="1.5dp">
        <ImageView android:id="@+id/widget_cell_border_6" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
