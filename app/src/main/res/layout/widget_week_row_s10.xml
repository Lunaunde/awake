    </FrameLayout>
    <FrameLayout android:id="@+id/widget_cell_7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginLeft="1.5dp" android:layout_marginRight="1.5dp">
