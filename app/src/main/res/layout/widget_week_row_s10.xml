<?xml version="1.0" encoding="utf-8"?>
<!-- Widget ListView row covering 10 period(s) (500dp).
     Course cells are merged into whole blocks by the factory (border/fill drawable pairs
     widget_cell_b_full/top/mid/bot + widget_cell_f_*); course text has NO ellipsis and a
     generous maxLines budget (20 lines) so the full name/room/parity tag stays visible.
     The left time column shows one label group per period, aligned with the period slices.
     Label ids: widget_rl_0.. / widget_rlt_0.. (colors are set by code per dark mode). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="500dp"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/widget_rl_col"
        android:layout_width="32dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="2dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:orientation="vertical" android:paddingTop="5dp">
            <TextView android:id="@+id/widget_rl_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:fontFamily="sans-serif" android:textColor="@color/widget_text_primary" android:textSize="9sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_rlt_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:includeFontPadding="false" android:lineSpacingExtra="-2dp" android:textColor="@color/widget_text_secondary" android:textSize="7sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:orientation="vertical" android:paddingTop="5dp">
            <TextView android:id="@+id/widget_rl_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:fontFamily="sans-serif" android:textColor="@color/widget_text_primary" android:textSize="9sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_rlt_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:includeFontPadding="false" android:lineSpacingExtra="-2dp" android:textColor="@color/widget_text_secondary" android:textSize="7sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:orientation="vertical" android:paddingTop="5dp">
            <TextView android:id="@+id/widget_rl_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:fontFamily="sans-serif" android:textColor="@color/widget_text_primary" android:textSize="9sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_rlt_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:includeFontPadding="false" android:lineSpacingExtra="-2dp" android:textColor="@color/widget_text_secondary" android:textSize="7sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:orientation="vertical" android:paddingTop="5dp">
            <TextView android:id="@+id/widget_rl_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:fontFamily="sans-serif" android:textColor="@color/widget_text_primary" android:textSize="9sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_rlt_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:includeFontPadding="false" android:lineSpacingExtra="-2dp" android:textColor="@color/widget_text_secondary" android:textSize="7sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:orientation="vertical" android:paddingTop="5dp">
            <TextView android:id="@+id/widget_rl_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:fontFamily="sans-serif" android:textColor="@color/widget_text_primary" android:textSize="9sp" android:textStyle="bold" />
