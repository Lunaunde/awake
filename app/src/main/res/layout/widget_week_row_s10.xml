        <ImageView android:id="@+id/widget_cell_bg_7" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
        <TextView android:id="@+id/widget_cell_tx_7" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:fontFamily="sans-serif" android:maxLines="20" android:lineSpacingExtra="-2dp" android:paddingLeft="3dp" android:paddingRight="3dp" android:textColor="@color/widget_text_primary" android:textSize="9sp" android:textStyle="bold" />
    </FrameLayout>
</LinearLayout>